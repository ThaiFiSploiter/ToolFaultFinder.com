---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { slugify, faultUrl } from '../../../lib/slug';
import { groupByBrand, hasHub, brandUrl } from '../../../lib/brands';

export async function getStaticPaths() {
  const entries = await getCollection('faults');

  // Related entries, in preference order: same brand, then same category, then a
  // rotating fill from the rest of the library. The rotation matters — it is what
  // guarantees every entry has at least one inbound link from another entry.
  // Several pages have sat "Discovered - currently not indexed" for weeks with no
  // link from anything Google had already crawled; /faults/ alone was not enough.
  const relatedFor = (entry: (typeof entries)[number]) => {
    const others = entries.filter((e) => e.id !== entry.id);
    const index = entries.indexOf(entry);
    const rotated = entries
      .slice(index + 1)
      .concat(entries.slice(0, index))
      .filter((e) => e.id !== entry.id);

    const picked: typeof entries = [];
    const push = (candidates: typeof entries) => {
      for (const c of candidates) {
        if (picked.length >= 4) return;
        if (!picked.some((p) => p.id === c.id)) picked.push(c);
      }
    };

    push(others.filter((e) => e.data.brand === entry.data.brand));
    push(others.filter((e) => e.data.category === entry.data.category));
    push(rotated);
    return picked;
  };

  // A brand only has a hub once it has enough entries to be worth one, so the
  // breadcrumb has to know whether /tools/<brand>/ actually exists before linking it.
  const brandHubs = new Set(groupByBrand(entries).filter(hasHub).map((g) => g.slug));

  return entries.map((entry) => ({
    params: {
      brand: slugify(entry.data.brand),
      model: slugify(entry.data.model),
    },
    props: {
      entry,
      related: relatedFor(entry),
      brandHub: brandHubs.has(slugify(entry.data.brand))
        ? brandUrl(slugify(entry.data.brand))
        : null,
    },
  }));
}

const { entry, related, brandHub } = Astro.props;
const { Content } = await render(entry);
const {
  seo_title,
  meta_description,
  brand,
  model,
  category,
  symptom,
  likely_cause,
  diagnostic_steps,
  fix_or_verdict,
  sources,
  date_published,
  image,
  image_alt,
} = entry.data;

const dateLabel = date_published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const pageUrl = faultUrl(entry);

const comments = (await getCollection('comments'))
  .filter((c) => c.data.entry === entry.id)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const renderedComments = await Promise.all(
  comments.map(async (c) => ({ data: c.data, Content: (await render(c)).Content }))
);

// Search-facing title. `symptom` reads well on the page but runs to 100-180
// characters as a <title>; Google renders about 60. `seo_title` is the short,
// front-loaded version and is used verbatim, with no site-name suffix.
const searchTitle = seo_title ?? `${brand} ${model} — ${symptom} · ToolFaultFinder`;
// On-page H1. Entries without a hand-written `seo_title` keep the old behaviour.
const headline = seo_title ?? symptom;
const searchDescription =
  meta_description ?? `${brand} ${model}: ${symptom}. Likely cause: ${likely_cause}`;

const absolute = (path: string) => new URL(path, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': absolute(pageUrl) + '#article',
      // Google asks for headline under ~110 chars; `symptom` regularly exceeds that.
      headline: seo_title ?? `${brand} ${model} — ${symptom}`,
      alternativeHeadline: `${brand} ${model} — ${symptom}`,
      description: searchDescription,
      about: `${brand} ${model}`,
      articleSection: category,
      datePublished: date_published.toISOString().slice(0, 10),
      inLanguage: 'en-GB',
      mainEntityOfPage: absolute(pageUrl),
      publisher: {
        '@type': 'Organization',
        name: 'ToolFaultFinder',
        url: absolute('/'),
      },
      ...(sources && sources.length > 0 ? { citation: sources } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      // Mirrors the URL path (/tools/<brand>/<model>/) rather than the old
      // Home > Faults > entry, which skipped the brand segment that is actually there.
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
        { '@type': 'ListItem', position: 2, name: 'Brands', item: absolute('/tools/') },
        ...(brandHub
          ? [{ '@type': 'ListItem', position: 3, name: brand, item: absolute(brandHub) }]
          : []),
        {
          '@type': 'ListItem',
          position: brandHub ? 4 : 3,
          name: `${brand} ${model}`,
          item: absolute(pageUrl),
        },
      ],
    },
  ],
};
---

<Base title={searchTitle} description={searchDescription} suffix={false}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <article class="wrap" data-pagefind-body>
    <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
      <a href="/">Home</a><span class="sep">/</span>
      <a href="/tools/">Brands</a><span class="sep">/</span>
      {brandHub ? (
        <>
          <a href={brandHub}>{brand}</a><span class="sep">/</span>
        </>
      ) : null}
      <span>{brand} {model}</span>
    </nav>

    <header class="article-head">
      <p class="kicker" data-pagefind-meta="title">{brand} {model}</p>
      <!--
        The H1 is the search title, not `symptom`. `symptom` is a 100-180 character
        reader-facing sentence, and using it here left the phrase people actually
        search for out of the page's most weighted heading entirely: /tools/bambu-lab/a1/
        drew 353 impressions in 28 days on "the printer is busy with another job", a
        string that appeared in the <title> (since 23 Aug) but nowhere in the H1.
        Aligning the two also gives Google less reason to rewrite the title in the SERP.
        The full sentence stays directly below, and again in Quick Facts.
      -->
      <h1>{headline}</h1>
      <p class="entry-standfirst">{symptom}</p>
    </header>

    {image && (
      <figure class="entry-hero" data-pagefind-ignore>
        <Image src={image} alt={image_alt ?? `${brand} ${model} — ${symptom}`} width={1200} />
      </figure>
    )}

    <div class="plate">
      <div class="plate-head">
        <span class="plate-title">Quick Facts</span>
      </div>
      <dl>
        <dt>Brand</dt>
        <dd>{brand}</dd>
        <dt>Model</dt>
        <dd><code>{model}</code></dd>
        <dt>Category</dt>
        <dd><span class="tag tag-category" data-pagefind-filter="category">{category}</span></dd>
        <dt>Symptom</dt>
        <dd>{symptom}</dd>
        <dt>Likely cause</dt>
        <dd>{likely_cause}</dd>
        <dt>Diagnostic steps</dt>
        <dd>
          <ol>
            {diagnostic_steps.map((step) => <li>{step}</li>)}
          </ol>
        </dd>
        <dt>Fix / verdict</dt>
        <dd><strong>{fix_or_verdict}</strong></dd>
        {sources && sources.length > 0 && (
          <>
            <dt>Sources</dt>
            <dd>
              <ul class="sources">
                {sources.map((src) => <li>{src}</li>)}
              </ul>
            </dd>
          </>
        )}
        <dt>Published</dt>
        <dd>{dateLabel}</dd>
      </dl>
    </div>

    <div class="safety-notice" data-pagefind-ignore>
      <strong>⚠ Work safe, at your own risk.</strong> Unplug before opening anything;
      capacitors can hold charge after power-off. This is general information, not
      professional advice — if you're not competent with mains-powered equipment, use a
      qualified technician. Full <a href="/terms/">terms &amp; liability disclaimer</a>.
    </div>

    <div class="article-body">
      <Content />
    </div>

    {related.length > 0 && (
      <section class="related" data-pagefind-ignore>
        <div class="section-head">
          <h2>Related Faults</h2>
        </div>
        <ul class="related-list">
          {related.map((r) => (
            <li>
              <a href={faultUrl(r)}>
                <span class="related-model">{r.data.brand} {r.data.model}</span>
                <span class="related-symptom">{r.data.symptom}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="comments" id="comments" data-pagefind-ignore>
      <div class="section-head">
        <h2>Comments &amp; Corrections</h2>
      </div>

      {renderedComments.length === 0 ? (
        <p class="no-comments">
          No comments yet. Had this fault yourself, or found something different? Tell us below.
        </p>
      ) : (
        <ol class="comment-list">
          {renderedComments.map(({ data, Content: CommentBody }) => (
            <li class="comment">
              <div class="comment-meta">
                <span class="comment-author">{data.author}</span>
                <span>{data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              </div>
              <div class="comment-body">
                <CommentBody />
              </div>
            </li>
          ))}
        </ol>
      )}

      <p id="comment-thanks" class="comment-thanks" hidden>
        Thanks — your comment has been sent for review. Comments are checked by a human
        before they appear, so expect a delay.
      </p>

      <form
        class="form-panel comment-form"
        name="entry-comments"
        method="POST"
        action={`${pageUrl}?comment=received#comments`}
        data-netlify="true"
        netlify-honeypot="website"
      >
        <input type="hidden" name="form-name" value="entry-comments" />
        <input type="hidden" name="entry" value={entry.id} />
        <p style="display: none;">
          <label>Leave this field empty: <input name="website" /></label>
        </p>

        <div class="form-field">
          <label for="comment-name">Name</label>
          <input type="text" id="comment-name" name="name" required maxlength="80" />
        </div>
        <div class="form-field">
          <label for="comment-email">Email (never published — only if we need to reply)</label>
          <input type="email" id="comment-email" name="email" />
        </div>
        <div class="form-field">
          <label for="comment-text">Comment</label>
          <textarea id="comment-text" name="comment" rows="5" required maxlength="4000"></textarea>
        </div>
        <button class="btn" type="submit">Submit comment</button>
        <p class="comment-note">
          Comments are reviewed before publishing — nothing appears automatically, and spam
          never appears at all.
        </p>
      </form>
    </section>
  </article>
</Base>

<script>
  if (new URLSearchParams(window.location.search).get('comment') === 'received') {
    document.getElementById('comment-thanks')?.removeAttribute('hidden');
    document.querySelector('.comment-form')?.setAttribute('hidden', '');
  }
</script>
