---
/**
 * Parts and consumables for a tool, in two clearly separated groups.
 *
 * "Parts You May Need" is repair parts — only ever the ones this entry's own
 * verdict says may need replacing. "Consumables & Accessories" is what the tool
 * gets through in normal use: bar oil, chains, blades, discs, bags, nozzles.
 * "If You're Replacing It" is a replacement machine, and appears only where the
 * verdict concludes the tool is uneconomic or unsafe to repair — on those pages
 * a new machine is precisely what the reader has just been told they need.
 *
 * They are split rather than merged on purpose. Consumables are the things a
 * reader is actually likely to buy, but they do not fix the fault the page is
 * about, and a single blended list would quietly imply that they might. The
 * separate heading and its standfirst say so outright.
 *
 * Renders whether or not affiliate links are on. With links off each item is
 * plain text, which still reads as useful reference.
 */
import { amazonSearchUrl, affiliateLive, type Part } from '../lib/affiliate';

interface Props {
  parts: Part[];
  /** "Stihl MS 250" — prefixed to generated search terms. */
  context: string;
}

const { parts, context } = Astro.props;
const live = affiliateLive();

const repair = parts.filter((p) => (p.kind ?? 'repair') === 'repair');
const consumable = parts.filter((p) => p.kind === 'consumable');
const replacement = parts.filter((p) => p.kind === 'replacement');
---

{parts.length > 0 && (
  <section class="parts" data-pagefind-ignore>
    {live && (
      <p class="parts-disclosure">
        <strong>As an Amazon Associate we earn from qualifying purchases.</strong> The
        links below go to <strong>Amazon UK</strong> and are affiliate links: if you buy
        through one it costs you nothing extra, and we get a small commission. It makes no
        difference to what this page says — the verdict above is written from the sources
        before anyone checks whether a part is purchasable.
        <a href="/affiliate-disclosure/">Full disclosure</a>.
      </p>
    )}

    {repair.length > 0 && (
      <>
        <div class="section-head">
          <h2>Parts You May Need</h2>
        </div>
        <ul class="parts-list">
          {repair.map((part) => {
            const href = amazonSearchUrl(part, context);
            return (
              <li>
                <span class="part-name">
                  {href ? (
                    <a href={href} rel="sponsored nofollow noopener" target="_blank">{part.name}</a>
                  ) : part.name}
                </span>
                {part.part_number && <code class="part-number">{part.part_number}</code>}
                {part.note && <span class="part-note">{part.note}</span>}
              </li>
            );
          })}
        </ul>
        <p class="parts-caveat">
          Check the part against your own tool's model and serial before ordering — ranges
          get revised and the same model name can cover more than one part.
        </p>
      </>
    )}

    {replacement.length > 0 && (
      <>
        <div class="section-head">
          <h2>If You're Replacing It</h2>
        </div>
        <p class="parts-standfirst">
          The verdict above weighs repairing this one against replacing it. If you've read
          that and the sums point at replacement, this is the class of machine that does the
          same job. If they don't, ignore this — the repair advice above stands.
        </p>
        <ul class="parts-list">
          {replacement.map((part) => {
            const href = amazonSearchUrl(part, context);
            return (
              <li>
                <span class="part-name">
                  {href ? (
                    <a href={href} rel="sponsored nofollow noopener" target="_blank">{part.name}</a>
                  ) : part.name}
                </span>
                {part.note && <span class="part-note">{part.note}</span>}
              </li>
            );
          })}
        </ul>
      </>
    )}

    {consumable.length > 0 && (
      <>
        <div class="section-head">
          <h2>Consumables &amp; Accessories</h2>
        </div>
        <p class="parts-standfirst">
          Not fixes for this fault — just what a {context} gets through in normal use, in
          case you're restocking while you're in here.
        </p>
        <ul class="parts-list">
          {consumable.map((part) => {
            const href = amazonSearchUrl(part, context);
            return (
              <li>
                <span class="part-name">
                  {href ? (
                    <a href={href} rel="sponsored nofollow noopener" target="_blank">{part.name}</a>
                  ) : part.name}
                </span>
                {part.part_number && <code class="part-number">{part.part_number}</code>}
                {part.note && <span class="part-note">{part.note}</span>}
              </li>
            );
          })}
        </ul>
        <p class="parts-caveat">
          Sizes and fitments vary within a model range — check yours before ordering.
        </p>
      </>
    )}
  </section>
)}
